# Server (Liara sets PORT automatically; keep 4000 locally)
PORT=4000
NODE_ENV=production

# PostgreSQL (on Liara: use values from the linked Postgres service)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=dental_rahmati
DB_PASSWORD=change-me
DB_DATABASE=dental_rahmati
# First deploy can be true; then switch to false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Admin JWT — must be a long random secret in production
JWT_SECRET=change-me-to-a-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe@Strong1
SUPERADMIN_NAME=سوپر ادمین
